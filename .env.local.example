# Copy this file to .env.local for local testing, and enter the same
# values in Vercel's Environment Variables when you deploy.

# From Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The single shared password your staff will use to log in.
# Pick something you'll remember; you can change it anytime in Vercel settings.
APP_PASSWORD=choose-a-password
